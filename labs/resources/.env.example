# Copy this file to .env in the repository root. .env is ignored by git.
# Replace placeholders locally. Never paste these values into prompts or commit them.
OPENAI_API_KEY=<OPENAI_API_KEY>
OPENAI_MODEL=gpt-5.6-sol
ALPACA_API_KEY=<ALPACA_PAPER_KEY>
ALPACA_SECRET_KEY=<ALPACA_PAPER_SECRET>
ALPACA_PAPER_ONLY=true
